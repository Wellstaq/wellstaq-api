# Copy this file to .env and fill in real local values.
# Never commit the actual .env file.

APP_NAME="Wellstaq API"
APP_ENV=development
APP_PORT=8000
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wellstaq

JWT_SECRET_KEY="ff38ef5d3788256162232929614430bb61057dfdf134b37f3a98ce14bdfaee9a"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

REDIS_URL=redis://localhost:6379/0

# Object storage — S3 or Cloudflare R2 (same API, just change these values).
# Leave STORAGE_ENDPOINT_URL blank for AWS S3.
# For R2: https://<account_id>.r2.cloudflarestorage.com and STORAGE_REGION=auto
STORAGE_ENDPOINT_URL=
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY_ID=replace_me
STORAGE_SECRET_ACCESS_KEY=replace_me
STORAGE_BUCKET_NAME=wellstaq-storage
STORAGE_PUBLIC_BASE_URL=
PRESIGNED_URL_EXPIRE_SECONDS=300

CORS_ORIGINS=["http://localhost:3000", "https://appwellstaq6.vercel.app", "https://wellstaqemployee.vercel.app"]

# Transactional email — Brevo HTTPS API
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_API_KEY=your_brevo_api_key
BREVO_HTTP_TIMEOUT_SECONDS=30
MAIL_FROM=info@producthubafrica.org
MAIL_FROM_NAME=Wellstaq
